# MoneyBags shared local environment
# Copy this file to .env. run-all.ps1 loads it for every backend service.

# MySQL shared connection
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=password

# Optional per-service overrides (uncomment only when a service uses another DB)
# AUTH_DB_URL=jdbc:mysql://localhost:3306/moneybags_identity?createDatabaseIfNotExist=true&serverTimezone=UTC
# IDENTITY_DB_URL remains supported as a backwards-compatible alias.
# CUSTOMER_DB_URL=jdbc:mysql://localhost:3306/moneybags_customer?createDatabaseIfNotExist=true&serverTimezone=UTC
# BRANCH_DB_URL=jdbc:mysql://localhost:3306/moneybags_branch?createDatabaseIfNotExist=true&serverTimezone=UTC
# CONFIG_DB_URL=jdbc:mysql://localhost:3306/moneybags_configuration?createDatabaseIfNotExist=true&serverTimezone=UTC
# PRODUCT_DB_URL=jdbc:mysql://localhost:3306/moneybags_product?createDatabaseIfNotExist=true&serverTimezone=UTC
# ACCOUNT_DB_URL=jdbc:mysql://localhost:3306/moneybags_account?createDatabaseIfNotExist=true&serverTimezone=UTC
# TRANSACTION_DB_URL=jdbc:mysql://localhost:3306/moneybags_transaction?createDatabaseIfNotExist=true&serverTimezone=UTC
# LEDGER_DB_URL=jdbc:mysql://localhost:3306/moneybags_ledger?createDatabaseIfNotExist=true&serverTimezone=UTC
# STATEMENT_DB_URL=jdbc:mysql://localhost:3306/moneybags_statement?createDatabaseIfNotExist=true&serverTimezone=UTC
# NOTIFICATION_DB_URL=jdbc:mysql://localhost:3306/moneybags_notification?createDatabaseIfNotExist=true&serverTimezone=UTC
# AUDIT_DB_URL=jdbc:mysql://localhost:3306/moneybags_audit?createDatabaseIfNotExist=true&serverTimezone=UTC
# KYC_DB_URL=jdbc:mysql://localhost:3306/moneybags_kyc?createDatabaseIfNotExist=true&serverTimezone=UTC

# Service discovery
EUREKA_SERVER_PORT=8080
EUREKA_HOSTNAME=localhost
EUREKA_URL=http://localhost:8080/eureka/

# Service ports
BRANCH_SERVICE_PORT=8081
CUSTOMER_SERVICE_PORT=8082
ACCOUNT_SERVICE_PORT=8083
TRANSACTION_SERVICE_PORT=8084
LEDGER_SERVICE_PORT=8085
STATEMENT_SERVICE_PORT=8086
AUTH_SERVICE_PORT=8087
# IDENTITY_SERVICE_PORT=8087  # backwards-compatible alias
PRODUCT_SERVICE_PORT=8088
NOTIFICATION_SERVICE_PORT=8089
API_GATEWAY_PORT=8090
AUDIT_SERVICE_PORT=8091
CONFIG_SERVICE_PORT=8092
KYC_SERVICE_PORT=8093

# Authentication - use a long random JWT secret outside local development
JWT_SECRET=moneybags-dev-only-jwt-secret-change-before-production
JWT_ISSUER=moneybags-identity
JWT_AUDIENCE=moneybags-api
JWT_EXPIRATION_MINUTES=15
MAX_FAILED_ATTEMPTS=5
LOCK_DURATION_MINUTES=15
AUTH_REGISTRATION_ENABLED=true
AUTH_DEFAULT_ROLE=CUSTOMER
AUTH_COOKIE_NAME=access-token
# Set true behind HTTPS in deployed environments. Keep false for local HTTP.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Strict

# Shared banking configuration
DEFAULT_CURRENCY=INR
GL_CASH_ASSET=110100
GL_ACCOUNT_DEPOSIT_CONTROL=210000
GL_TERM_DEPOSIT_CONTROL=210100
GL_INTERNAL_CLEARING=220100
GL_EXTERNAL_CLEARING=220200
GL_FEE_INCOME=410100

# Account service
ACCOUNT_DORMANCY_DAYS=365
ACCOUNT_OUTBOX_ENABLED=true
ACCOUNT_OUTBOX_BATCH_SIZE=50
ACCOUNT_OUTBOX_MAX_ATTEMPTS=10
ACCOUNT_OUTBOX_DELAY_MS=5000
ACCOUNT_RECONCILIATION_ENABLED=true
ACCOUNT_RECONCILIATION_DELAY_MS=60000

# Customer service
KYC_EXPIRY_ALERT_CRON=0 0 8 * * *

# Transaction service
TRANSACTION_MINI_STATEMENT_SIZE=10
TRANSACTION_OUTBOX_BATCH_SIZE=50
TRANSACTION_OUTBOX_DELAY_MS=5000
TRANSACTION_OUTBOX_MAX_ATTEMPTS=10

# Statement/reporting service
STATEMENT_STORAGE_DIR=./data/statements
STATEMENT_DOWNLOAD_SECRET=change-this-development-secret-before-production
STATEMENT_DOWNLOAD_LINK_MINUTES=10
STATEMENT_FILE_RETENTION_DAYS=30
STATEMENT_WORKER_DELAY_MS=2000

# Notification service
NOTIFICATION_BATCH_SIZE=50
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_DELAY_MS=5000

# KYC service
KYC_MAX_FILE_SIZE=50MB
KYC_MAX_REQUEST_SIZE=100MB
